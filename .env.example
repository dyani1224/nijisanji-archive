# 화면(브라우저)에 들어가는 값. 공개돼도 되는 값이며, 데이터 보호는 Supabase RLS 가 맡는다.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=여기에-anon-public-키

# 서버(Vercel 함수)에서만 읽는 값. 브라우저에 나가지 않는다.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=여기에-anon-public-키
# 선택. 있으면 채널 정보와 라이브 여부를 YouTube Data API 로 정확히 가져온다. 없으면 RSS 로 최근 15개만.
YOUTUBE_API_KEY=
